<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#6676B900"
                android:centerColor="#3376B900"
                android:endColor="#1576B900"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#8876B900" />
        </shape>
    </item>
</ripple>