<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#5541E7A8"
                android:centerColor="#2241E7A8"
                android:endColor="#1141E7A8"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#AA41E7A8" />
        </shape>
    </item>
</ripple>